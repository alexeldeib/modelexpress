+    if (nixl_mem_type == nixl_mem_t::VRAM_SEG) {
+        mem_params.field_mask |= UCP_MEM_MAP_PARAM_FIELD_MEMORY_TYPE;
+        mem_params.memory_type = UCS_MEMORY_TYPE_CUDA;
+    }

     ucs_status_t status = ucp_mem_map(ctx, &mem_params, &mem.memh);
